<IfModule mod_rewrite.c>
RewriteEngine On
# existing files (style.css, robots.txt, img/...) served directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# config.php holds live tokens: never serve it over HTTP (PHP includes via
# the filesystem keep working - this only blocks direct web access, e.g. if
# the PHP handler ever fails and source would download as text).
<IfModule mod_authz_core.c>
<Files config.php>
Require all denied
</Files>
</IfModule>
<IfModule !mod_authz_core.c>
<Files config.php>
Order deny,allow
Deny from all
</Files>
</IfModule>

# Hide directory structure where no index file exists.
<IfModule mod_autoindex.c>
Options -Indexes
</IfModule>

# EPG pages are big flat HTML tables (per-program tooltips): compress the
# text responses. Negotiated via Accept-Encoding, so old browsers without
# it transparently get identity. Guarded: no mod_deflate = no-op.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/json application/xml text/xml
</IfModule>

# style.css is version-pinned (?v=...), safe to cache long.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 week"
</IfModule>
